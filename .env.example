# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production Expo Web origin allowed to call /api/v1. Dev defaults to "*".
API_ALLOWED_ORIGIN="http://localhost:8081"

# ---- i18n ----
# First visit is always Turkish. English only after an explicit switch
# (language toggle / ?lang=en / hoflayn_locale cookie / users.locale).
# Browser Accept-Language and IP country do not change the default.
# LOCALE_DEBUG_COUNTRY is unused for UI language; kept for older local notes.
# LOCALE_DEBUG_COUNTRY="US"

# ---- Supabase ----
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service role key: SERVER ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- Database (Drizzle) ----
# App/runtime: Supabase Transaction pooler (port 6543) is fine for serverless.
# Migrations (`npm run db:migrate`): use Session pooler or Direct (port 5432).
# Transaction pooler cannot run DDL ("tenant or user not found").
# Format: postgresql://postgres.<ref>:<password>@<host>:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# ---- AI providers (optional; mock used when unset) ----
# REPLICATE_API_TOKEN="r8_..."
# REPLICATE_REMBG_VERSION="fb8af171cfa1616ddcf1242c093f9c46bcada5ad4cf6f2fbe8b81b330ec5c003"
# OPENAI_API_KEY="sk-..."
# OPENAI_TEXT_MODEL="gpt-4o-mini"
# OPENAI_TIMEOUT_MS="45000"
# Never enable in production except for an intentional isolated smoke environment.
# ALLOW_MOCK_AI="false"
# DEV_UNLOCK_WRITER="true"  # optional: allow writer mock when entitlement is off
# Production defaults to deferred jobs. Set true only for local/debug execution.
# AI_JOBS_INLINE="false"
# Random 32+ character bearer secret for /api/internal/ai-worker.
# AI_WORKER_SECRET="replace-with-a-random-secret"
# Vercel Cron can use CRON_SECRET instead of AI_WORKER_SECRET.
# CRON_SECRET="replace-with-a-random-secret"
# AI_WORKER_BATCH_SIZE="3"

# ---- Storage ----
# Create a private bucket named "media-assets" in Supabase Storage.
# Paths are tenant-prefixed: {tenantId}/raw/... and {tenantId}/processed/...

# ---- Billing (Stripe; see docs/STRIPE_CUTOVER.md for live cutover) ----
# STRIPE_SECRET_KEY="sk_test_..."   # or sk_live_... in production
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRO_PRICE_ID="price_..."
# STRIPE_CREDITS_50_PRICE_ID="price_..."
# STRIPE_CREDITS_200_PRICE_ID="price_..."
# Optional: must match key prefix when set
# STRIPE_MODE="test"
# Local only: allow sk_live_ on localhost / NODE_ENV=development
# ALLOW_STRIPE_LIVE="true"

# ---- Hoflayn Web Bridge (same values as hoflayn-online production) ----
# Infrastructure only for now: users stay on the workbench. Do not commit real keys.
# PHP inbound webhook: https://hoflayn.app/api/bridge/webhook/hoflayn-web
# PHP DEFAULT_CATEGORY_ID=2  SITE_BASE_URL=https://hoflayn.com
# HOFLAYN_WEB_BRIDGE_URL="https://hoflayn.com/integrations/hoflayn-bridge/product-create.php"
# HOFLAYN_WEB_BRIDGE_API_KEY="shared-with-php"
# HOFLAYN_WEB_BRIDGE_SIGNING_SECRET="shared-with-php"
# HOFLAYN_WEB_BRIDGE_WEBHOOK_SECRET="shared-with-php"

# ---- Google Sign-In (Supabase Auth provider — not Next.js / Expo runtime) ----
# Paste Client ID + Secret in Supabase → Authentication → Providers → Google.
# Use the same web OAuth client as hoflayn.com. Never put GOOGLE_CLIENT_SECRET
# in Expo public env or commit it. Google Cloud Console (same client) must add:
#   Authorized JavaScript origins:
#     https://hoflayn.app
#     http://localhost:3000
#   Authorized redirect URIs:
#     https://<PROJECT_REF>.supabase.co/auth/v1/callback
#     https://hoflayn.com/functions/core/auth/endpoints/google-callback.php  (keep)
# Supabase Auth → URL Configuration → Redirect URLs:
#     https://hoflayn.app/auth/callback
#     http://localhost:3000/auth/callback
#     hoflayn://auth/callback
# Native Play "Google Sign-In" SDK later needs a separate Android OAuth client
# (package app.hoflayn.mobile + SHA-1). This app uses browser OAuth; the web
# Client ID is serverClientId if/when @react-native-google-signin is added.
# Google login creates a Supabase user only — no PHP users row.
# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"

# ---- AI cost caps (provider USD; see docs/COSTING.md) ----
# HOURLY_TENANT_USD_CAP="5"
# DAILY_TENANT_USD_CAP="20"

# ---- Signup gate (public launch vs closed beta) ----
# Public market launch: leave these UNSET / empty.
#   ALLOWLIST_EMAILS, BETA_SIGNUPS_CLOSED, BETA_MAX_TENANTS
# Empty allowlist = open signup. Do not ship production with a leftover allowlist.
# SUPPORT_EMAIL="destek@hoflayn.app"
# STUDIO_JOBS_PER_MINUTE="10"
# Closed beta only (comma-separated). Empty = gate off (open signup).
# ALLOWLIST_EMAILS="uretimci1@atelier.com,uretimci2@studio.com"
# Hard-close all new signups.
# BETA_SIGNUPS_CLOSED="false"
# Optional capacity cap (tenant count). When reached → invite_exhausted.
# BETA_MAX_TENANTS="10"

# ---- Local developer test account (never set in production) ----
# DEV_TEST_EMAIL="test@user.com"
# DEV_TEST_PASSWORD="123456"
# DEV_TEST_API_URL="http://127.0.0.1:3000"
