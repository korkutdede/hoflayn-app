{
  "name": "hoflayn.app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "mobile:start": "npm run start --workspace mobile",
    "mobile:tunnel": "npm exec --workspace mobile -- expo start --tunnel",
    "mobile:android": "npm run android --workspace mobile",
    "mobile:web": "npm run web --workspace mobile",
    "mobile:lint": "npm run lint --workspace mobile",
    "mobile:typecheck": "npm run typecheck --workspace mobile",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-plans.ts",
    "test-user:seed": "tsx scripts/seed-test-user.ts",
    "preflight": "tsx scripts/preflight.ts",
    "beta:smoke": "tsx scripts/beta-smoke.ts",
    "ai:providers:check": "tsx scripts/check-ai-providers.ts",
    "beta:funnel": "tsx scripts/beta-funnel.ts",
    "storage:gc": "tsx scripts/storage-gc.ts"
  },
  "dependencies": {
    "@hoflayn/calc": "*",
    "@hoflayn/i18n": "*",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "bwip-js": "^4.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "pdfkit": "^0.19.1",
    "postgres": "^3.4.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bwip-js": "^3.2.3",
    "@types/node": "^20.19.43",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
