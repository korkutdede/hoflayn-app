# Public values only. Never copy DATABASE_URL or service-role keys here.
EXPO_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"

# Physical phones cannot reach your computer through localhost.
# Use your computer's LAN IP during development, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL="http://YOUR_LAN_IP:3000"

# Keep false for App Store / Play builds until external billing policy is approved.
EXPO_PUBLIC_ENABLE_EXTERNAL_BILLING="false"

# Optional later: web OAuth client ID as native Google Sign-In serverClientId.
# Browser OAuth via Supabase does not need this. Never add the client secret here.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="....apps.googleusercontent.com"
